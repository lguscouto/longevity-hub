{
  "name": "longevidade-frontend",
  "private": true,
  "version": "2.4.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:visual": "playwright test e2e/visual-regression.spec.ts --project=chromium --config=e2e/playwright.config.ts",
    "test:visual:update": "playwright test e2e/visual-regression.spec.ts --project=chromium --config=e2e/playwright.config.ts --update-snapshots",
    "audit:design-system": "node scripts/audit-design-system.mjs",
    "audit:design-system:baseline": "node scripts/audit-design-system.mjs --update-baseline"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react-is": "^19.0.0"
  }
}
